/* Style helper for dynamic HTML inside subpage contents */
.subpage-html-content h1,
.subpage-html-content h2,
.subpage-html-content h3 {
  font-weight: 800;
  color: var(--text-primary);
  margin-top: 1.5rem;
  margin-bottom: 1rem;
}
.subpage-html-content h1 { font-size: 1.8rem;
}
.subpage-html-content h2 { font-size: 1.4rem;
}
.subpage-html-content h3 { font-size: 1.2rem;
}
.subpage-html-content p {
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: 1.2rem;
}
.subpage-html-content ul,
.subpage-html-content ol {
  margin-bottom: 1.5rem;
  padding-left: 1.5rem;
}
.subpage-html-content li {
  color: var(--text-muted);
  margin-bottom: 0.6rem;
  line-height: 1.6;
}
.subpage-html-content strong {
  color: var(--text-primary);
}
.fade-enter-active, .fade-leave-active {
  transition: opacity 0.3s ease-in-out;
}
.fade-enter, .fade-leave-to {
  opacity: 0;
}
</style><style type="text/css">
.fade-slide-enter-active[data-v-f352d82e], .fade-slide-leave-active[data-v-f352d82e] {
  transition: all 0.3s ease-out;
}
.fade-slide-enter[data-v-f352d82e] {
  opacity: 0;
  transform: translateY(10px);
}
.fade-slide-leave-to[data-v-f352d82e] {
  opacity: 0;
  transform: translateY(-10px);
}
</style><script charset="utf-8" src="./SETMC.PL - Oficjalny Sklep Minecraft_files/a606041.js.pobrany plik"></script><style type="text/css">
/* Style helper for HTML descriptions in product cards */
.product-card-desc {
  font-size: 0.88rem;
  color: var(--text-muted);
  line-height: 1.5;
  margin-top: 8px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.product-card-desc p {
  margin-bottom: 0px;
}

/* Large centered product image */
.product-img-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  min-height: 140px;
}
.product-img-large {
  max-width: 100%;
  max-height: 160px;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 8px;
}
.product-img-emoji {
  font-size: 4rem;
}
.btn-checkout-orange:hover {
  background: #ffaa1c !important;
  transform: scale(1.04);
  box-shadow: 0 4px 12px rgba(255, 159, 0, 0.25) !important;
}
.btn-checkout-orange:active {
  transform: scale(0.98);
}
.checkout-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 24px 16px;
  overflow-y: auto;
  background: rgba(16, 16, 20, 0.62);
}
.checkout-modal {
  position: relative;
  width: min(480px, 100%);
  margin: auto;
  padding: 32px 28px 28px;
}
.checkout-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 36px;
  height: 36px;
  border: none;
  border-radius: 50%;
  background: #f3f3f5;
  color: #1a1a1e;
  font-size: 1.4rem;
  line-height: 1;
  cursor: pointer;
}
.checkout-modal .slider-value {
  color: #ff9f00;
}
.checkout-range::-webkit-slider-thumb {
  background: #ff9f00;
}
.checkout-range::-moz-range-thumb {
  background: #ff9f00;
}
.qty-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 14px 0;
}
.qty-presets button {
  border: 1.5px solid rgba(0, 0, 0, 0.08);
  background: #fff;
  color: #1a1a1e;
  border-radius: 999px;
  padding: 6px 12px;
  font-weight: 700;
  font-size: 0.82rem;
  cursor: pointer;
}
.qty-presets button.active {
  background: #ff9f00;
  border-color: #ff9f00;
  color: #fff;
}
.checkout-qty-input {
  margin-top: 4px;
}
.checkout-total {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  margin: 8px 0 18px;
  padding: 16px;
  border-radius: 16px;
  background: rgba(255, 159, 0, 0.1);
}
.checkout-total span {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: #8e8e93;
}
.checkout-total strong {
  font-size: 1.8rem;
  font-weight: 900;
  color: #ff9f00;
}
.checkout-total small,
.checkout-note {
  color: #8e8e93;
  font-size: 0.82rem;
  margin: 0 0 12px;
}
.checkout-note.is-ok { color: #30d158;
}
.checkout-note.is-bad { color: #ff453a;
}
.promo-row {
  display: flex;
  gap: 8px;
}
.promo-row .form-input {
  flex: 1;
  margin: 0;
}
.promo-apply {
  border: none;
  border-radius: 12px;
  padding: 0 16px;
  background: #1a1a1e;
  color: #fff;
  font-weight: 700;
  cursor: pointer;
}
.pay-methods {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.pay-methods button {
  border: 1.5px solid rgba(0, 0, 0, 0.08);
  background: #fff;
  border-radius: 12px;
  padding: 10px 14px;
  font-weight: 700;
  cursor: pointer;
}
.pay-methods button.active {
  border-color: #ff9f00;
  background: rgba(255, 159, 0, 0.12);
}
.rules-check {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 8px 0 16px;
  font-size: 0.9rem;
  font-weight: 600;
  color: #1a1a1e;
}
.rules-check input {
  margin-top: 3px;
  accent-color: #ff9f00;
}
.rules-check a {
  color: #ff9f00;
  text-decoration: underline;
}
.checkout-sms {
  margin-bottom: 12px;
  font-size: 0.88rem;
  color: #444450;
}
.btn-pay {
  width: 100%;
  border: none;
  border-radius: 999px;
  padding: 14px 20px;
  background: #ff9f00;
  color: #fff;
  font-weight: 800;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  cursor: pointer;
}
.btn-pay:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
</style></head>
